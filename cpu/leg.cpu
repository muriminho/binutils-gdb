(include "simplify.inc")

(define-arch
  (name leg) ; name of cpu family
  (comment "LEG.")
  (default-alignment aligned)
  (insn-lsb0? #t)
  (machs leg)
  (isas leg)
)


; Instruction sets.

(define-isa
  (name leg)
  (comment "Leg ISA")
  (default-insn-word-bitsize 64)
  (default-insn-bitsize 64)
  (base-insn-bitsize 64)
  (decode-assist (7 6 5 4 3 2 1 0))
)


; Cpu family definitions.

(define-cpu
  ; cpu names must be distinct from the architecture name and machine name
  (name legbf)
  (comment "Leg CPU")
  (endian little)
  (word-bitsize 64)
)

(define-mach
  (name leg)
  (comment "Leg MACH")
  (cpu legbf)
)

(define-model
  (name leg)
  (comment "Leg implementation")
  (mach leg)
  (unit u-exec "Execution unit" ()
    1 1 () () () ())
) 


; Hardware elements.

(dnh h-pc "Program counter" (PC) (pc) () () ())

(dnh h-gr "General purpose registers"
  ()
  (register DI (64))
  (keyword "" ( 
               (r0 0) (r1 1) (r2 2) (r3 3)
               (r4 4) (r5 5) (r6 6) (r7 7)
               (r8 8) (r9 9) (r10 10) (r11 11)
               (r12 12) (r13 13) (r14 14) (r15 15)
              )
  )
  () ()
)
  
(dnh h-csr "Control and status registers"
  ()
  (register DI (64))
  (keyword "" (
               (IE 0) (IM 1) (IP 2) 
               (ICC 3) (DCC 4)
               (CC 5)
               (CFG 6)
               (EBA 7)
               (DC 8)
               (DEBA 9)
	       (CFG2 10)
               (JTX 14) (JRX 15)          
               (BP0 16) (BP1 17) (BP2 18) (BP3 19)
               (WP0 24) (WP1 25) (WP2 26) (WP3 27)     
               (PSW 29) (TLBVADDR 30) (TLBPADDR 31) (TLBBADVADDR 31)
              )
  )
  () ()
)              

; Instruction fields.

(dnf f-opcode   "opcode field"                ()   7  8)
(dnf f-dest       "register index 0 field"      () 15  8)
(dnf f-src1       "register index 1 field"      () 23  8)
(dnf f-src2       "register index 2 field"      () 31  8)
(dnf f-imm      "signed immediate field"      ()   63 32)
(dnf f-uimm     "unsigned immediate field"    ()   63 32)
(dnf f-branch     "branch offset field"    ()      63 32)

; Operands.

(dnop dest      "destinatination register 0"   () h-gr         f-dest)
(dnop addrg      "address register"            () h-gr         f-dest)
(dnop src1      "source register 1"            () h-gr         f-src1)
(dnop src2      "source register 2"            () h-gr         f-src2)
(dnop imm       "signed immediate"             () h-sint       f-imm)
(dnop uimm      "unsigned immediate"           () h-uint       f-uimm)
(dnop addr      "unsigned address"             () h-uint       f-uimm)
(dnop branch    "branch offset"                () h-iaddr      f-branch)            

; Enumerations.

(define-normal-insn-enum
  opcodes "opcodes" () OP_ f-opcode
  (
        ("NOP"       1)
        ("EXIT"       2)
        ("JUMP"       3)
        ("JUMPREG"       4)
        ("MOV"       5)
        ("MOVIMM"       6)
        ("LOAD64" 7)
        ("STORE64" 8)
        ("LOAD32" 8)
        ("STORE32" 9)
        ("LOAD16" 10)
        ("STORE16" 11)
        ("LOAD8" 12)
        ("STORE8" 13)
        ("JEQ" 14)
        ("JEQIMM" 15)
        ("JLE" 16)
        ("JLEU" 17)
        ("JLER" 18)
        ("JLEUR" 19)

        ("JL" 20)
        ("JLU" 21)
        ("JLR" 22)
        ("JLUR" 23)
  )
)
 

; Instructions. Note: Reg-reg must come before reg-imm.

(dni nop "no op" ()
        "nop"
        (+ OP_NOP (f-dest 0) (f-src1 0) (f-src2 0) (f-imm 0))
        (nop)
        ()
)

(dni exit "exit vm" ()
        "exit"
        (+ OP_EXIT (f-dest 0) (f-src1 0) (f-src2 0) (f-imm 0))
        (nop)
        ()
)

(dni jump "jump to a 32 bit offset" ()
        "jump $branch"
        (+ OP_JUMP (f-dest 0) (f-src1 0) (f-src2 0) branch)
        (set pc branch)
        ()
)

(dni jumpreg "jump to a 32 bit offset from register" ()
        "jumpr $dest"
        (+ OP_JUMPREG dest (f-src1 0) (f-src2 0) (f-imm 0))
        (set pc dest)
        ()
)

(dni mov "mov to reg from reg" ()
        "movr $dest,$src1"
        (+ OP_MOV dest src1 (f-src2 0) (f-imm 0))
        (set dest src1)
        ()
)

(dni movimm "mov to reg from imm" ()
        "mov $dest,$uimm"
        (+ OP_MOVIMM dest (f-src1 0) (f-src2 0) uimm)
        (set dest uimm)
        ()
)

(dni load64 "mov 64 bit to reg from mem" ()
        "ldrq $addrg,$src1"
        (+ OP_LOAD64 addrg src1 (f-src2 0) (f-imm 0))
        (set dest (mem DI src1))
        ()
)

(dni store64 "mov 64 bit to mem from reg" ()
        "strq $addrg,$src1"
        (+ OP_STORE64 addrg src1 (f-src2 0) (f-imm 0))
        (set (mem DI src1) dest)
        ()
)

(dni load32 "mov 32 bit to reg from mem" ()
        "ldrw $addrg,$src1"
        (+ OP_LOAD32 addrg src1 (f-src2 0) (f-imm 0))
        (set dest (mem SI src1))
        ()
)

(dni store32 "mov 32 bit to mem from reg" ()
        "strw $addrg,$src1"
        (+ OP_STORE32 addrg src1 (f-src2 0) (f-imm 0))
        (set (mem SI src1) dest)
        ()
)

(dni load16 "mov 16 bit to reg from mem" ()
        "ldrh $addrg,$src1"
        (+ OP_LOAD16 addrg src1 (f-src2 0) (f-imm 0))
        (set dest (mem HI src1))
        ()
)

(dni store16 "mov 16 bit to mem from reg" ()
        "strh $addrg,$src1"
        (+ OP_STORE16 addrg src1 (f-src2 0) (f-imm 0))
        (set (mem HI src1) dest)
        ()
)

(dni load8 "mov 8 bit to reg from mem" ()
        "ldrb $addrg,$src1"
        (+ OP_LOAD8 addrg src1 (f-src2 0) (f-imm 0))
        (set dest (mem QI src1))
        ()
)

(dni store8 "mov 8 bit to mem from reg" ()
        "strb $addrg,$src1"
        (+ OP_STORE8 addrg src1 (f-src2 0) (f-imm 0))
        (set (mem QI src1) dest)
        ()
)

(dni jeqr "jump is equal regs" ()
        "jeqr $src1,$src2,$addrg"
        (+ OP_JEQ addrg src1 src2 (f-imm 0))
        (if (eq src1 src2) (set pc addrg))
        ()
)

(dni jeq "jump if equal imm" ()
        "jeq $src1,$src2,$branch"
        (+ OP_JEQIMM (f-dest 0) src1 src2 branch)
        (if (eq src1 src2) (set pc branch))
        ()
)

(dni jler "jle regs" ()
        "jler $src1,$src2,$addrg"
        (+ OP_JLER addrg src1 src2 (f-imm 0))
        (if (le src1 src2) (set pc addrg))
        ()
)

(dni jleur "jleu regs" ()
        "jleur $src1,$src2,$addrg"
        (+ OP_JLEUR addrg src1 src2 (f-imm 0))
        (if (leu src1 src2) (set pc addrg))
        ()
)

(dni jle "jle imm" ()
        "jle $src1,$src2,$branch"
        (+ OP_JLE (f-dest 0) src1 src2 branch)
        (if (le src1 src2) (set pc branch))
        ()
)

(dni jleu "jleu imm" ()
        "jleu $src1,$src2,$branch"
        (+ OP_JLEU (f-dest 0) src1 src2 branch)
        (if (leu src1 src2) (set pc branch))
        ()
)


(dni jlr "jl regs" ()
        "jlr $src1,$src2,$addrg"
        (+ OP_JLR addrg src1 src2 (f-imm 0))
        (if (lt src1 src2) (set pc addrg))
        ()
)

(dni jlur "jlu regs" ()
        "jlur $src1,$src2,$addrg"
        (+ OP_JLUR addrg src1 src2 (f-imm 0))
        (if (ltu src1 src2) (set pc addrg))
        ()
)

(dni jl "jl imm" ()
        "jl $src1,$src2,$branch"
        (+ OP_JL (f-dest 0) src1 src2 branch)
        (if (lt src1 src2) (set pc branch))
        ()
)

(dni jlu "jlu imm" ()
        "jlu $src1,$src2,$branch"
        (+ OP_JLU (f-dest 0) src1 src2 branch)
        (if (ltu src1 src2) (set pc branch))
        ()
)
